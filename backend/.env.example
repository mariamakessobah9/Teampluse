# ---------------------------------------------------------------------------
# Base de donnees
# ---------------------------------------------------------------------------
# En production (Railway) : definir uniquement DATABASE_URL.
# En local : laisser DATABASE_URL vide et renseigner les variables ci-dessous.
# DATABASE_URL=postgresql://user:password@host:5432/railway
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=teampulse

# TLS vers Postgres. false sur le reseau prive Railway
# (*.railway.internal), true si on passe par le proxy public.
DB_SSL=false

# true = TypeORM cree/modifie les tables au demarrage. Indispensable au tout
# premier deploiement, a passer a false ensuite (risque de perte de donnees).
DB_SYNCHRONIZE=true

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Railway bloque le SMTP sortant (587 et 465 en timeout) : en production il
# faut une API HTTPS. La premiere cle presente gagne, le SMTP sert de dernier
# recours et convient au developpement local.
# BREVO_API_KEY=
# SENDGRID_API_KEY=

# Adresse expeditrice. Doit etre verifiee chez le fournisseur.
# Par defaut, MAIL_USER.
# MAIL_FROM=

# SMTP (developpement local)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# PORT est injecte automatiquement par Railway, ne pas le definir la-bas.
PORT=3000
APP_URL=http://localhost:3000

# Redis : partage les diffusions Socket.IO et l'etat des appels entre
# instances. Absente, tout fonctionne mais sur une seule instance.
# REDIS_URL=redis://localhost:6379

# Liste separee par des virgules ou * pour autoriser toutes les origines.
# L'app mobile n'envoie pas d'origine : * est acceptable ici.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# WebRTC / TURN
# ---------------------------------------------------------------------------
# Servis aux clients par GET /api/calls/ice-servers. Sans TURN, les appels
# echouent entre certains reseaux mobiles (NAT symetrique).
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:votre-turn.example.com:3478,turns:votre-turn.example.com:5349

# Mode recommande : identifiants ephemeres derives d'un secret partage
# (coturn --use-auth-secret, ou l'equivalent chez un fournisseur manage).
# TURN_SECRET=
# TURN_TTL_SECONDS=86400

# Repli : identifiants statiques, utilises seulement si TURN_SECRET est absent.
# TURN_USERNAME=
# TURN_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudinary
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
