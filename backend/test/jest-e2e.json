{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/test/tsconfig.json"
      }
    ]
  },
  "testTimeout": 60000,
  "maxWorkers": 1,
  "setupFiles": [
    "<rootDir>/test/setup-env.ts"
  ],
  "moduleNameMapper": {
    "^expo-server-sdk$": "<rootDir>/test/stubs/expo-server-sdk.ts"
  }
}
